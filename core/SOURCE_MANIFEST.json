  "source_bytes": 513731,
  "source_archive_limitations": [
    "This is a source snapshot, not a newly ported executable distribution. Native loaders/build scripts still bind the original build identities and reviews; those local historical files are deliberately not exported. Fresh execution requires new paths, local build receipts, and dependency identities.",
    "AH mainline uses block_acquisition.acquire; Bessel mainline uses fair_acquire.acquire with ordinary_int. Optional older AH/Bessel backend branches in fair_acquire and recovery are outside this export.",
    "Ordered matrix readout uses rank_query.query or grid_query.query. Their old-readout helpers and local packed-composition sources are included; native binaries must be rebuilt externally.",
    "The optional standalone validation branches of ah_native.py and fast_convolution.py are not exported.",
    "PARI methods.run_pari and its setup/input helpers are included. The optional historical run_shared comparison helper requires an unexported candidate implementation and is outside this export.",
    "Direct PARI is a separate N=2,4,6,8,12; L=2,3 historical campaign. The unchanged direct_run.py binds an original Python path and expects the original artifact layout. query.py is a new input-checking launcher for the unchanged worker; it was not used for the recorded timings. direct_worker_failed.py is retained only as failure provenance. See pari_direct_20260930/README.md."
  ],
  "external_dependencies": [
    "Python 3.13.15 was used for the reported measurements",
    "python-flint 0.9.0 and FLINT 3.6.0",
    "GMP/MPFR and matching FLINT public development headers for native builds",
    "cypari2 2.2.4 and PARI 2.17.3 for the PARI baseline"
  ],
  "entrypoints": {
    "AH acquisition": "optimized_pair_20261004/reconstruction/block_second/block_acquisition.py:acquire",
    "Bessel acquisition": "optimized_pair_20261004/reconstruction/carrier_coverage/fair_acquire.py:acquire(ordinary_int, ...)",
    "rank readout": "optimized_pair_20261004/reconstruction/rank_extension/rank_query.py:query",
    "expanded grid readout": "optimized_pair_20261004/reconstruction/grid_12x12_20261004/grid_query.py:query",
    "sequential and binary convolution": "rank_cost_optimized_20260930/reference/code/convolution.py:run",
    "packed convolution": "rank_cost_optimized_20260930/code/fast_convolution.py:run",
    "FWHT": "rank_cost_optimized_20260930/code/fwht.py:run",
    "PARI cyclic powering": "pari_variable_rank_20260930/code/methods.py:run_pari",
    "PARI low-rank point counting": "pari_direct_20260930/direct_worker.py:main"
  }
